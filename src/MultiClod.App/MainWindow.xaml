<Window x:Class="MultiClod.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiClod.App"
        xmlns:mde="clr-namespace:MultiClod.App.MarkdownEditor"
        xmlns:se="clr-namespace:MultiClod.App.Skills.SkillEditor"
        xmlns:context="clr-namespace:MultiClod.App.Context"
        xmlns:settings="clr-namespace:MultiClod.App.Settings"
        xmlns:costs="clr-namespace:MultiClod.App.Costs"
        xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Multi-Clod" Height="600" Width="1000"
        KeyboardNavigation.DirectionalNavigation="None"
        KeyboardNavigation.TabNavigation="None"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <!--
        DirectionalNavigation/TabNavigation="None" on the Window is required, not just on
        WpfTerminalPane's own internal container: without it, pressing an arrow key while the
        hosted native terminal has focus makes WPF's navigation system move focus up to an
        ancestor control instead of the terminal's native hwnd, and every subsequent keystroke
        then silently goes nowhere.
    -->
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:ProjectNodeViewModel}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" Margin="2"
                       TextTrimming="CharacterEllipsis" />
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type local:SessionNodeViewModel}" ItemsSource="{Binding Children}">
            <!--
                A Grid, not a StackPanel: the name column below is "*" so it actually shrinks as
                the tree panel narrows, which is what lets SessionNameText's TextTrimming kick in.
                A horizontal StackPanel measures children at infinite width, so a TextBlock inside
                one never trims - it just grows past the row's bounds. See the TreeViewItem
                ControlTemplate's own column swap (name "*" / cost Auto) below for the other half
                of this fix.
            -->
            <Grid Margin="2" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- A Canvas, not a Grid: WPF applies an automatic "layout clip" to a child whose
                     Arrange size ends up smaller than what it asked for at Measure time, and a
                     fixed-size Grid (as this was) gives every child exactly its own 10x10 bounds
                     as that Arrange size regardless of ClipToBounds (which was already, and still
                     is, unset/false - this clip is a separate mechanism). WorkingSpinner's 16x16
                     therefore got Arranged into a 10x10 slot and clipped down to whatever of its
                     geometry fell inside that box - four small corner fragments of the ring - which
                     is the "spinning square" both the original dashed-Ellipse design (confirmed by
                     rendering that exact old markup standalone) and the newer arc-based Path
                     (confirmed the same way) actually were the whole time; the dash-cap-shape theory
                     the old Path comment argued for was never the real cause. A Canvas sidesteps
                     this because it measures children with infinite available size and Arranges
                     each one at exactly its own DesiredSize - never smaller - so nothing this Canvas
                     hosts, however larger than the nominal 10x10, is clipped. Canvas.Left/Top below
                     substitute for the HorizontalAlignment/VerticalAlignment="Center" this used
                     when it was a Grid (Canvas ignores both): each child is positioned by hand at
                     (10 - child width)/2, (10 - child height)/2 to keep the same centering - e.g.
                     WorkingSpinner's -3,-3 for its 16x16 size, StatusDot's -1,-1 for its 12x12 size.
                     Recompute those if any child's size changes. -->
                <Canvas Grid.Column="0" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                    <!-- IsHollow (NotStarted/Exited/Dormant) swaps Fill for Transparent below, leaving just the Stroke outline. -->
                    <Ellipse x:Name="StatusDot" Canvas.Left="-1" Canvas.Top="-1" Width="12" Height="12" Fill="{Binding StatusBrush}"
                             Stroke="{Binding StatusBrush}" StrokeThickness="1.5" />
                    <!-- Rotating dashed ring stands in for the dot while the session is Starting - see the IsStarting trigger below. -->
                    <Ellipse x:Name="StatusSpinner" Canvas.Left="-1" Canvas.Top="-1" Width="12" Height="12" Visibility="Collapsed"
                             Stroke="Goldenrod" StrokeThickness="1.5" StrokeDashArray="2 1.5"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="StatusSpinnerRotate" Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- Solid (non-dashed) ring in violet signals Claude actively working on a
                         turn - distinct in both color and dash pattern from the goldenrod dashed
                         IsStarting spinner above. See the Activity==Working trigger below. Four
                         explicit 60-degree arcs with 30-degree gaps (via Path/ArcSegment, one
                         PathFigure per arc) rather than an Ellipse with StrokeDashArray, whose flat
                         (non-round) dash-end caps, cut perpendicular to the path, read as a square's
                         corner rather than a dash at this thickness:radius ratio. Round line caps
                         soften the arc endpoints so the gaps read as gaps, not more corners. A first
                         attempt used a 75/15 degree arc/gap split (matching the old dashed Ellipse's
                         dash:gap ratio) but rendered to a PNG at this control's actual 16x16 size,
                         that gap all but disappears into anti-aliasing - it reads as a near-solid
                         ring, not 4 separate arcs; 60/30 (rendered and confirmed legible at 16x16
                         before committing this) is the narrowest gap that still reads clearly here -
                         don't go back to a smaller gap without re-rendering it standalone to check.
                         Points below are literal (not templated) because they're derived from this
                         Ellipse's own former geometry - cx=cy=8 (center of the 16x16 box) and r=6.8
                         (radius to the stroke's centerline, i.e. (16 - StrokeThickness) / 2 with
                         StrokeThickness=2.4, matching the old Ellipse's ring) - so recompute all 8
                         (x,y) pairs if either changes. Four 60-degree arcs with four 30-degree gaps
                         make up the full circle (4*60 + 4*30 = 360); IsLargeArc=0 since each arc is
                         under 180 degrees, and SweepDirection=1 (clockwise) since angles increase
                         clockwise on screen (y-down). -->
                    <Path x:Name="WorkingSpinner" Canvas.Left="-3" Canvas.Top="-3" Width="16" Height="16" Visibility="Collapsed"
                          Stretch="None" Stroke="MediumPurple" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M14.568,9.760 A6.8,6.8 0 0 1 9.760,14.568
                                M6.240,14.568 A6.8,6.8 0 0 1 1.432,9.760
                                M1.432,6.240 A6.8,6.8 0 0 1 6.240,1.432
                                M9.760,1.432 A6.8,6.8 0 0 1 14.568,6.240"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="WorkingSpinnerRotate" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                    <!-- How many background agents are running, overlaid in the spinner's own
                         hollow center - empty text (see SessionNodeViewModel.BackgroundTaskBadgeText)
                         while there's nothing to show, so a session with no background agents just
                         gets a plain spinner. Same Orange as DoneGlyph's checkmark rather than the
                         ring's MediumPurple, since that's what needs to be legible at this size, not
                         color-matched to the ring around it. Doesn't rotate with the ring - only the
                         ring's Stroke does (RenderTransform on WorkingSpinner itself). Wrapped in its
                         own 10x10 Grid (rather than a bare TextBlock, as before the Canvas switch)
                         because Canvas doesn't stretch children to fill it the way the old Grid did -
                         without an explicitly-sized container to center within, the auto-sized
                         TextBlock's HorizontalAlignment/VerticalAlignment="Center" would have nothing
                         to center against. -->
                    <Grid Canvas.Left="0" Canvas.Top="0" Width="10" Height="10">
                        <TextBlock x:Name="BackgroundTaskBadge" Text="{Binding BackgroundTaskBadgeText}"
                                   FontSize="11" FontWeight="Bold" Foreground="Orange"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,-1,0,0" />
                    </Grid>
                    <!-- Latches until the user re-selects this session - see
                         SessionNodeViewModel.ClearLatchedActivity. Explicit Width/Height for the same
                         reason as BackgroundTaskBadge's wrapper Grid above - Canvas won't stretch it
                         to 10x10 on its own. -->
                    <Grid x:Name="NeedsInputGlyph" Canvas.Left="-1" Canvas.Top="-1" Width="12" Height="12" Visibility="Collapsed">
                        <Ellipse Width="12" Height="12" Fill="Orange" />
                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Grid>
                    <Grid x:Name="DoneGlyph" Canvas.Left="-1" Canvas.Top="-1" Width="12" Height="12" Visibility="Collapsed">
                        <TextBlock Text="&#10003;" FontSize="11" FontWeight="Bold" Foreground="Orange"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Grid>
                    <!-- Static (non-rotating) gray dashed ring - Claude Code's Stop hook never
                         fires for a user-interrupted turn, so unlike NeedsInput/Done this doesn't
                         come from a structured signal; we only know the turn was cut off, not what
                         state it was actually in, so this deliberately looks "frozen mid-flight"
                         rather than reusing WorkingSpinner's animation or NeedsInput/Done's glyphs.
                         Also latches until the user re-selects this session - see
                         SessionNodeViewModel.ClearLatchedActivity. -->
                    <Ellipse x:Name="InterruptedGlyph" Canvas.Left="-1" Canvas.Top="-1" Width="12" Height="12" Visibility="Collapsed"
                             Stroke="Gray" StrokeThickness="1.5" StrokeDashArray="3 1" />
                    <!-- The CLI printed its own "API Error: ..." line (e.g. a dropped connection
                         mid-response) - see TerminalSession.HandleApiErrorDetected. Red rather than
                         NeedsInputGlyph's orange, since this means something actually broke rather
                         than Claude waiting on an answer. Also latches until the user re-selects
                         this session - see SessionNodeViewModel.ClearLatchedActivity. -->
                    <Grid x:Name="ErrorGlyph" Canvas.Left="-1" Canvas.Top="-1" Width="12" Height="12" Visibility="Collapsed">
                        <Ellipse Width="12" Height="12" Fill="Crimson" />
                        <TextBlock Text="!" FontSize="10" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Grid>
                </Canvas>
                <TextBlock x:Name="SessionNameText" Grid.Column="1" Text="{Binding Name}"
                           Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                    <Setter TargetName="SessionNameText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="SessionNameText" Property="Foreground" Value="{DynamicResource Theme.Brush.SecondaryForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHollow}" Value="True">
                    <Setter TargetName="StatusDot" Property="Fill" Value="Transparent" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStarting}" Value="True">
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="StatusSpinner" Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="SpinnerStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="StatusSpinnerRotate" Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinnerStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static local:SessionActivity.Working}">
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="WorkingSpinner" Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="WorkingSpinnerStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="WorkingSpinnerRotate" Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="WorkingSpinnerStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static local:SessionActivity.NeedsInput}">
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NeedsInputGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static local:SessionActivity.Done}">
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DoneGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static local:SessionActivity.Interrupted}">
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="InterruptedGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static local:SessionActivity.Error}">
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ErrorGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!--
            CLAUDE.md and its @import tree (Context\ContextTreeBuilder) - Missing/Cycle nodes grey
            out via the same SecondaryForeground convention as SessionNodeViewModel's IsInvalid
            above, but Italic rather than Strikethrough: these files aren't invalid, just not yet
            created or already expanded earlier in this chain. The two states are distinguished via
            ToolTipText rather than separate colors, to keep the visual vocabulary small.
        -->
        <HierarchicalDataTemplate DataType="{x:Type context:ContextFileNodeViewModel}" ItemsSource="{Binding Children}">
            <TextBlock x:Name="ContextNodeText" Text="{Binding Name}" ToolTip="{Binding ToolTipText}"
                       Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" Margin="2" TextTrimming="CharacterEllipsis" />
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="ContextNodeText" Property="Foreground" Value="{DynamicResource Theme.Brush.SecondaryForeground}" />
                    <Setter TargetName="ContextNodeText" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCycle}" Value="True">
                    <Setter TargetName="ContextNodeText" Property="Foreground" Value="{DynamicResource Theme.Brush.SecondaryForeground}" />
                    <Setter TargetName="ContextNodeText" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!--
            Trimmed copy of the shared (implicit, below) TreeViewItem style for ContextTree: same
            selection-highlight visuals and IsSelected/IsExpanded bindings, but no drag/drop
            EventSetters or CostBadge column - those assume Sessions-tree semantics that don't apply
            to a CLAUDE.md/@import node. Assigned explicitly via ContextTree's ItemContainerStyle,
            which takes precedence over the implicit (unkeyed) style below for that TreeView's
            containers.
        -->
        <Style x:Key="ContextTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <EventSetter Event="Selected" Handler="OnItemSelected" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="19" Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" ClickMode="Press"
                                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Width" Value="16" />
                                        <Setter Property="Height" Value="16" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Height="16" Padding="5" Width="16">
                                                        <Path x:Name="ExpandPath" Data="M0,0L0,6L6,0z"
                                                              Fill="LimeGreen" Stroke="LimeGreen">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="135" CenterX="3" CenterY="3" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="RenderTransform" TargetName="ExpandPath">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="180" CenterX="3" CenterY="3" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Grid.Column="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.Row="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter Property="Visibility" TargetName="ItemsHost" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Visibility" TargetName="Expander" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static sys:SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static sys:SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static sys:SystemColors.ControlBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static sys:SystemColors.ControlTextBrushKey}}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static sys:SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Drag/drop is wired on every TreeViewItem via this shared style, AND separately on the
            Tree element itself in the TreeView tag below (see OnTreeDragOver/OnTreeDrop) - a
            TreeView's rows don't fill its whole bounds, so a drop below the last item routes to
            the TreeView, not any TreeViewItem. Because DragOver/Drop are bubbling routed events, a
            drop that lands on an actual row is handled by that row's own handler first, which
            marks e.Handled = true so the Tree-level handler only ever fires for genuine
            empty-area drops - no manual hit-testing needed to tell the two cases apart.

            IsSelected/IsExpanded are TwoWay so code (e.g. MainWindow.HandleFromHereRequest) can
            select/expand a node by setting the view model, and WPF applies it whenever that
            node's container materializes - no polling ItemContainerGenerator for a container that
            may not exist yet.
        -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <EventSetter Event="Selected" Handler="OnItemSelected" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemPreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnItemPreviewMouseMove" />
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="DragOver" Handler="OnItemDragOver" />
            <EventSetter Event="Drop" Handler="OnItemDrop" />
            <!--
                Full retemplate rather than a resource-key override: the default (Aero2) template
                pulls its expand/collapse glyph style via a StaticResource lookup that's resolved
                inside the theme's own dictionary, so an app-level resource of the same key is
                never seen. Re-declaring the whole template is the only way to force the glyph's
                color - this copies the stock Aero2 layout/selection triggers verbatim and only
                replaces the ToggleButton's glyph style with a fixed LimeGreen triangle (matching
                the running-session status dot color) instead of the stock dark/hover-only colors.
            -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="19" Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" ClickMode="Press"
                                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Width" Value="16" />
                                        <Setter Property="Height" Value="16" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Height="16" Padding="5" Width="16">
                                                        <Path x:Name="ExpandPath" Data="M0,0L0,6L6,0z"
                                                              Fill="LimeGreen" Stroke="LimeGreen">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="135" CenterX="3" CenterY="3" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="RenderTransform" TargetName="ExpandPath">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="180" CenterX="3" CenterY="3" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Grid.Column="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <!--
                                Deliberately a sibling of Bd (the selection-highlighted header
                                border above), not inside it - Column 1 (Bd/name) is "*" so it
                                shrinks as the tree panel narrows (its TextBlock then trims via
                                TextTrimming), while this badge lives in Column 2, which is Auto so
                                it always renders at its full natural size and stays flush against
                                the GridSplitter regardless of how long the name is - a long name
                                trims away rather than pushing the cost off the visible edge. The
                                TreeViewItem's own DataContext is whatever node is bound (project or
                                session), which is why CostBadgeText has a safe always-null default
                                on the shared TreeNodeViewModel base - a project row binds
                                harmlessly.
                            -->
                            <costs:CostBadge Grid.Row="0" Grid.Column="2" CostText="{Binding CostBadgeText}"
                                              BreakdownText="{Binding CostBreakdownText}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter Property="Visibility" TargetName="ItemsHost" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Visibility" TargetName="Expander" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static sys:SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static sys:SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static sys:SystemColors.ControlBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static sys:SystemColors.ControlTextBrushKey}}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static sys:SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One tab per open session in the main panel's tab strip (MainWindow.TabStrip) - see
            MainWindow.OpenTab/CloseTab. Mirrors the tree's status-dot glyphs (IsHollow/NeedsInput/
            Done/Interrupted) so a background tab still signals it needs attention without
            switching to it, but skips the tree's animated Starting/Working spinners - not worth
            the extra visual noise
            at tab-strip size.
        -->
        <DataTemplate x:Key="SessionTabItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="6,3" ToolTip="{Binding ToolTipText}">
                <Grid Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse x:Name="TabStatusDot" Width="8" Height="8" Fill="{Binding StatusBrush}"
                             Stroke="{Binding StatusBrush}" StrokeThickness="1.5" />
                    <Grid x:Name="TabNeedsInputGlyph" Visibility="Collapsed">
                        <Ellipse Width="10" Height="10" Fill="Orange" />
                        <TextBlock Text="?" FontSize="8" FontWeight="Bold" Foreground="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Grid>
                    <Grid x:Name="TabDoneGlyph" Visibility="Collapsed">
                        <TextBlock Text="&#10003;" FontSize="9" FontWeight="Bold" Foreground="Orange"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Grid>
                    <!-- Static, not animated - matches InterruptedGlyph in the tree's own template. -->
                    <Ellipse x:Name="TabInterruptedGlyph" Width="10" Height="10" Visibility="Collapsed"
                             Stroke="Gray" StrokeThickness="1.5" StrokeDashArray="3 1" />
                    <!-- Matches ErrorGlyph in the tree's own template. -->
                    <Grid x:Name="TabErrorGlyph" Visibility="Collapsed">
                        <Ellipse Width="10" Height="10" Fill="Crimson" />
                        <TextBlock Text="!" FontSize="8" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Grid>
                </Grid>
                <TextBlock Text="{Binding DisplayTitle}" Foreground="White" VerticalAlignment="Center"
                           MaxWidth="160" TextTrimming="CharacterEllipsis" />
                <costs:CostBadge CostText="{Binding CostBadgeText}" BreakdownText="{Binding CostBreakdownText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <Button Content="&#10005;" Width="16" Height="16" Margin="8,0,0,0" Padding="0"
                        Background="Transparent" BorderThickness="0" Foreground="Gray" Cursor="Hand"
                        VerticalAlignment="Center" Click="OnCloseTabClick" ToolTip="Close tab" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHollow}" Value="True">
                    <Setter TargetName="TabStatusDot" Property="Fill" Value="Transparent" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static local:SessionActivity.NeedsInput}">
                    <Setter TargetName="TabStatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TabNeedsInputGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static local:SessionActivity.Done}">
                    <Setter TargetName="TabStatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TabDoneGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static local:SessionActivity.Interrupted}">
                    <Setter TargetName="TabStatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TabInterruptedGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Activity}" Value="{x:Static local:SessionActivity.Error}">
                    <Setter TargetName="TabStatusDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TabErrorGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Selected tab gets the same blue accent (bottom edge) as the tree's focused-selection
             highlight, for visual consistency; unselected tabs are flat with a thin divider.

             Drag/drop reordering is wired here (per item) AND separately on the TabStrip ListBox
             itself (see OnTabStripDragOver/OnTabStripDrop) - same split as the tree's own DnD:
             the horizontal StackPanel of tabs doesn't fill the ListBox's full width, so a drop
             past the last tab routes to the ListBox, not any ListBoxItem. Bubbling DragOver/Drop
             means a drop on an actual tab is handled (and marked e.Handled = true) by that tab's
             own handler first, so the ListBox-level handler only ever fires for a genuine
             past-the-last-tab drop. -->
        <Style x:Key="SessionTabItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,1,2" />
            <Setter Property="BorderBrush" Value="#2D2D30" />
            <Setter Property="Foreground" Value="White" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTabItemPreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnTabItemPreviewMouseMove" />
            <EventSetter Event="PreviewMouseDown" Handler="OnTabItemPreviewMouseDown" />
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="DragOver" Handler="OnTabItemDragOver" />
            <EventSetter Event="Drop" Handler="OnTabItemDrop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E1E" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A96DD" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252526" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- BorderThickness starts at 0 (invisible) - MainWindow's ctor sets it to a visible red
         border under #if DEBUG, since XAML itself can't be conditionally compiled. -->
    <Border x:Name="DebugBorder" BorderBrush="Red" BorderThickness="0">
    <Grid Background="{DynamicResource Theme.Brush.WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition x:Name="TreeColumn" Width="220" MinWidth="120" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!--
            Rail: icon strip for major features. Each item's accent bar Visibility and the
            corresponding Panel/canvas content are driven from code-behind by
            MainWindow.SetRailSection (see RailSection) - MouseLeftButtonDown on each icon
            Grid calls into it.
        -->
        <Border Grid.Column="0" Background="{DynamicResource Theme.Brush.RailBackground}" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,0,1,0">
            <StackPanel>
                <Grid x:Name="SessionsRailIcon" Width="48" Height="48" Margin="0,8,0,0"
                      MouseLeftButtonDown="OnSessionsRailIconClick" ToolTip="Claude Sessions">
                    <!-- Accent bar marks this item as the one owning the currently visible Panel. -->
                    <Border x:Name="SessionsAccentBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Theme.Brush.Accent}" />
                    <Border Width="32" Height="32" Background="{DynamicResource Theme.Brush.RailTileBackground}" CornerRadius="4">
                        <!-- Single sunburst petal-flower, echoing the coral bursts in Assets/app.png (the app's own icon) at one-third scale. -->
                        <Canvas Width="24" Height="24">
                            <Canvas.Resources>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Width" Value="3" />
                                    <Setter Property="Height" Value="11" />
                                    <Setter Property="Fill" Value="{DynamicResource Theme.Brush.AccentCoral}" />
                                    <Setter Property="Canvas.Left" Value="10.5" />
                                    <Setter Property="Canvas.Top" Value="1" />
                                </Style>
                            </Canvas.Resources>
                            <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="0" CenterX="1.5" CenterY="11" /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="60" CenterX="1.5" CenterY="11" /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="120" CenterX="1.5" CenterY="11" /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="180" CenterX="1.5" CenterY="11" /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="240" CenterX="1.5" CenterY="11" /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="300" CenterX="1.5" CenterY="11" /></Ellipse.RenderTransform></Ellipse>
                        </Canvas>
                    </Border>
                </Grid>

                <Grid x:Name="ContextRailIcon" Width="48" Height="48"
                      MouseLeftButtonDown="OnContextRailIconClick" ToolTip="Context / Skills">
                    <Border x:Name="ContextAccentBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Theme.Brush.Accent}" Visibility="Collapsed" />
                    <Border Width="32" Height="32" Background="{DynamicResource Theme.Brush.RailTileBackground}" CornerRadius="4">
                        <!-- Simple document/sheet glyph (rounded card + three ruled lines) for the Skills panel.
                             The card and its ruled lines are a fixed pair (not theme-linked) - the lines are
                             just cutout strokes against the card's own AccentSecondary fill, unrelated to the
                             surrounding window theme. -->
                        <Canvas Width="24" Height="24">
                            <Border Width="16" Height="20" Canvas.Left="4" Canvas.Top="2" CornerRadius="2" Background="{DynamicResource Theme.Brush.AccentSecondary}" />
                            <Rectangle Width="10" Height="1.5" Canvas.Left="7" Canvas.Top="7" Fill="#1E1E1E" />
                            <Rectangle Width="10" Height="1.5" Canvas.Left="7" Canvas.Top="11" Fill="#1E1E1E" />
                            <Rectangle Width="6" Height="1.5" Canvas.Left="7" Canvas.Top="15" Fill="#1E1E1E" />
                        </Canvas>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsRailIcon" Width="48" Height="48"
                      MouseLeftButtonDown="OnSettingsRailIconClick" ToolTip="Settings">
                    <Border x:Name="SettingsAccentBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Theme.Brush.Accent}" Visibility="Collapsed" />
                    <Border Width="32" Height="32" Background="{DynamicResource Theme.Brush.RailTileBackground}" CornerRadius="4">
                        <!-- Gear glyph from Assets/settings.png, used as an OpacityMask over a plain
                             fill so its alpha shape renders in the rail's icon color instead
                             of the source PNG's own black. -->
                        <Rectangle Width="20" Height="20" Fill="{DynamicResource Theme.Brush.PrimaryForeground}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Assets/settings.png" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="SessionSubPanelRow" Height="40" />
            </Grid.RowDefinitions>

            <TreeView x:Name="Tree" Grid.Row="0" Background="{DynamicResource Theme.Brush.WindowBackground}" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AllowDrop="True"
                      SelectedItemChanged="OnTreeSelectedItemChanged"
                      KeyDown="OnTreeKeyDown"
                      PreviewMouseDown="OnTreePreviewMouseDown"
                      MouseRightButtonDown="OnTreeMouseRightButtonDown"
                      ContextMenuOpening="OnTreeContextMenuOpening"
                      DragOver="OnTreeDragOver"
                      Drop="OnTreeDrop">
                <TreeView.Resources>
                    <!-- Focused-selected row: echoes the terminal pane's own text-selection accent (ThemeManager's Accent color) for visual consistency. -->
                    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightBrushKey}" Color="{DynamicResource Theme.Color.Accent}" />
                    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightTextBrushKey}" Color="White" />

                    <!--
                        Unfocused-selected row: Aero2's TreeViewItem template (unlike ListBoxItem) uses
                        ControlBrushKey/ControlTextBrushKey for this state rather than the newer
                        InactiveSelectionHighlight* keys, so both pairs are overridden defensively - an
                        unused pair is a harmless no-op. Without this, an unfocused selected row falls
                        back to plain light gray behind hardcoded white text, which is illegible - and
                        the tree is frequently unfocused since the hosted terminal control constantly
                        steals keyboard focus.
                    -->
                    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedBackground}" />
                    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlTextBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedForeground}" />
                    <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedBackground}" />
                    <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedForeground}" />
                </TreeView.Resources>
                <TreeView.ContextMenu>
                    <ContextMenu x:Name="TreeContextMenu" />
                </TreeView.ContextMenu>
            </TreeView>

            <!--
                Context/Skills panel: CLAUDE.md + its @import tree (ContextTree, unaffected by the
                accordion below) stacked above two collapsible groups - Skills and Output Styles -
                see MainWindow.SetRailSection/ToggleContextGroup. Mutually exclusive with Tree via
                Visibility, same convention as the canvas's own children below. One shared
                Visibility flag controls both stacked children together, since they're always
                shown/hidden as a unit.
            -->
            <ScrollViewer x:Name="ContextPanel" Grid.RowSpan="3" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- CLAUDE.md (Context\ClaudeConfigDirectory) and its recursive @imports (Context\ContextTreeBuilder) - kept at a bounded MaxHeight with its own internal scroll (deep import trees), unlike the two groups below. -->
                    <TreeView x:Name="ContextTree" MaxHeight="220" Background="{DynamicResource Theme.Brush.WindowBackground}" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemContainerStyle="{StaticResource ContextTreeItemStyle}"
                              SelectedItemChanged="OnContextTreeSelectedItemChanged"
                              MouseRightButtonDown="OnContextTreeMouseRightButtonDown"
                              ContextMenuOpening="OnContextTreeContextMenuOpening">
                        <TreeView.Resources>
                            <!-- Same selection-highlight overrides as Tree above, duplicated since each TreeView's Resources is its own scope. -->
                            <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightBrushKey}" Color="{DynamicResource Theme.Color.Accent}" />
                            <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightTextBrushKey}" Color="White" />
                            <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedBackground}" />
                            <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlTextBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedForeground}" />
                            <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedBackground}" />
                            <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedForeground}" />
                        </TreeView.Resources>
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="ContextTreeContextMenu" />
                        </TreeView.ContextMenu>
                    </TreeView>

                    <!--
                        Skills group header - click toggles SkillsGroupContent's Visibility in
                        code-behind (ToggleContextGroup). Opacity dims to DimmedIconOpacity when
                        EnsureSkillsLoaded finds nothing, matching the session sub-panel's icons -
                        still clickable so the empty-state text below remains reachable.
                    -->
                    <Border x:Name="SkillsGroupHeader" Height="28" Background="Transparent" Cursor="Hand"
                            BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,1,0,0"
                            MouseLeftButtonDown="OnSkillsGroupHeaderClick">
                        <!-- Static content, unlike the per-item "Explore to" menus below - always
                             valid (~/.claude/skills always resolves), so no ContextMenuOpening
                             plumbing is needed. -->
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add new" Click="OnAddNewPersonalSkillClick" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Polyline x:Name="SkillsGroupChevron" Points="0,0 5,4 0,8" Width="6" Height="8" VerticalAlignment="Center"
                                      Stroke="{DynamicResource Theme.Brush.SecondaryForeground}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent">
                                <Polyline.RenderTransform>
                                    <RotateTransform x:Name="SkillsGroupChevronRotate" Angle="90" CenterX="3" CenterY="4" />
                                </Polyline.RenderTransform>
                            </Polyline>
                            <TextBlock Text="Skills" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" />
                        </StackPanel>
                    </Border>

                    <!--
                        Flat list of personal skills (~/.claude/skills/*/SKILL.md), populated in
                        code-behind by MainWindow.EnsureSkillsLoaded. No internal scrolling of its
                        own (ScrollViewer.VerticalScrollBarVisibility="Disabled") - it sizes to fit
                        every item, and the outer ScrollViewer above scrolls the whole panel if
                        that (plus everything else) doesn't fit the available height.
                    -->
                    <Grid x:Name="SkillsGroupContent">
                        <ListBox x:Name="SkillsList" Background="{DynamicResource Theme.Brush.WindowBackground}" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnSkillsListSelectionChanged"
                                 MouseRightButtonDown="OnSkillsListMouseRightButtonDown"
                                 ContextMenuOpening="OnSkillsListContextMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="SkillsContextMenu" />
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <StackPanel.ToolTip>
                                            <!-- Path on its own line, full description wrapped below it at a fixed
                                                 width - some descriptions run long, so an unconstrained tooltip
                                                 would otherwise stretch across the screen. -->
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Info.FilePath}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel.ToolTip>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" />
                                        <!-- Description is left plain (no visibility converter for the null/empty
                                             case) - an empty TextBlock with no MinHeight collapses to zero height
                                             visually, so there's no blank gap worth the extra converter class.
                                             TextTrimming (rather than TextWrapping) keeps each row a single line -
                                             a long description is cut off with an ellipsis instead of growing the
                                             row or triggering horizontal scrolling. -->
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="SkillsEmptyText" Text="No skills found" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>

                    <!-- Output Styles group header - mirrors SkillsGroupHeader exactly; see OnOutputStylesGroupHeaderClick. -->
                    <Border x:Name="OutputStylesGroupHeader" Height="28" Background="Transparent" Cursor="Hand"
                            BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,1,0,0"
                            MouseLeftButtonDown="OnOutputStylesGroupHeaderClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Polyline x:Name="OutputStylesGroupChevron" Points="0,0 5,4 0,8" Width="6" Height="8" VerticalAlignment="Center"
                                      Stroke="{DynamicResource Theme.Brush.SecondaryForeground}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent">
                                <Polyline.RenderTransform>
                                    <RotateTransform x:Name="OutputStylesGroupChevronRotate" Angle="90" CenterX="3" CenterY="4" />
                                </Polyline.RenderTransform>
                            </Polyline>
                            <TextBlock Text="Output Styles" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" />
                        </StackPanel>
                    </Border>

                    <!-- Flat list of personal output styles (~/.claude/output-styles/*.md), populated by MainWindow.EnsureOutputStylesLoaded - same no-internal-scroll/ellipsis-trim shape as SkillsGroupContent above. -->
                    <Grid x:Name="OutputStylesGroupContent">
                        <ListBox x:Name="OutputStylesList" Background="{DynamicResource Theme.Brush.WindowBackground}" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnOutputStylesListSelectionChanged"
                                 MouseRightButtonDown="OnOutputStylesListMouseRightButtonDown"
                                 ContextMenuOpening="OnOutputStylesListContextMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="OutputStylesContextMenu" />
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <StackPanel.ToolTip>
                                            <!-- Path on its own line, full description wrapped below it at a fixed
                                                 width - some descriptions run long, so an unconstrained tooltip
                                                 would otherwise stretch across the screen. -->
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Info.FilePath}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel.ToolTip>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" />
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="OutputStylesEmptyText" Text="No output styles found" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!--
                Horizontal splitter between Tree and SessionSubPanelHost - visible only while
                RailSection.Sessions is active and the sub-panel is expanded (see SetRailSection/
                SetSessionSubPanelCollapsed via UpdateSessionSubPanelSplitterVisibility). Collapsed
                to a fixed-height strip, there's nothing to drag, so it's hidden rather than shown
                inert.
            -->
            <GridSplitter x:Name="SessionSubPanelSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource Theme.Brush.WindowBackground}" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />

            <!--
                Session-scoped sub-panel: Memories + repo-local Context/Skills for whichever session
                tab is in the foreground - see MainWindow.SetSessionSubSection/
                SetSessionSubPanelCollapsed/RefreshSessionSubPanelForActiveTab. Only meaningful while
                RailSection.Sessions is active, so its own Visibility is toggled alongside Tree's in
                SetRailSection.
            -->
            <Grid x:Name="SessionSubPanelHost" Grid.Row="2">
                <!-- Expanded: [48px vertical mini-rail][content], matching the main rail's width. -->
                <Grid x:Name="SessionSubPanelExpanded" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Theme.Brush.RailBackground}" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <Grid x:Name="SessionMemoriesIcon" Width="48" Height="48" Margin="0,4,0,0"
                                  MouseLeftButtonDown="OnSessionMemoriesIconClick" ToolTip="Memories">
                                <Border x:Name="SessionMemoriesAccentBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Theme.Brush.Accent}" Visibility="Collapsed" />
                                <Border Width="32" Height="32" Background="{DynamicResource Theme.Brush.RailTileBackground}" CornerRadius="4">
                                    <!-- ThoughtBubble glyph, Segoe Fluent Icons (U+EA91) - a hand-drawn brain silhouette
                                         doesn't read clearly at this size. -->
                                    <TextBlock Text="&#xEA91;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                               Foreground="{DynamicResource Theme.Brush.AccentSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid x:Name="SessionContextSkillsIcon" Width="48" Height="48"
                                  MouseLeftButtonDown="OnSessionContextSkillsIconClick" ToolTip="Context / Skills (this repo)">
                                <Border x:Name="SessionContextSkillsAccentBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Theme.Brush.Accent}" Visibility="Collapsed" />
                                <Border Width="32" Height="32" Background="{DynamicResource Theme.Brush.RailTileBackground}" CornerRadius="4">
                                    <Canvas Width="24" Height="24">
                                        <Border Width="16" Height="20" Canvas.Left="4" Canvas.Top="2" CornerRadius="2" Background="{DynamicResource Theme.Brush.AccentSecondary}" />
                                        <Rectangle Width="10" Height="1.5" Canvas.Left="7" Canvas.Top="7" Fill="#1E1E1E" />
                                        <Rectangle Width="10" Height="1.5" Canvas.Left="7" Canvas.Top="11" Fill="#1E1E1E" />
                                        <Rectangle Width="6" Height="1.5" Canvas.Left="7" Canvas.Top="15" Fill="#1E1E1E" />
                                    </Canvas>
                                </Border>
                            </Grid>

                            <Grid x:Name="SessionOutputStylesIcon" Width="48" Height="48"
                                  MouseLeftButtonDown="OnSessionOutputStylesIconClick" ToolTip="Output Styles (this repo)">
                                <Border x:Name="SessionOutputStylesAccentBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Theme.Brush.Accent}" Visibility="Collapsed" />
                                <Border Width="32" Height="32" Background="{DynamicResource Theme.Brush.RailTileBackground}" CornerRadius="4">
                                    <!-- Palette glyph (blob + three paint-dab dots) - visually distinct from the document/thought-bubble glyphs used elsewhere on this rail. -->
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Width="18" Height="14" Canvas.Left="3" Canvas.Top="5" Fill="{DynamicResource Theme.Brush.AccentSecondary}" />
                                        <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="9" Fill="{DynamicResource Theme.Brush.AccentCoral}" />
                                        <Ellipse Width="4" Height="4" Canvas.Left="11" Canvas.Top="7" Fill="#1E1E1E" />
                                        <Ellipse Width="4" Height="4" Canvas.Left="15" Canvas.Top="10" Fill="{DynamicResource Theme.Brush.Accent}" />
                                    </Canvas>
                                </Border>
                            </Grid>

                            <!-- Explicit collapse affordance - the collapsed strip has no drag handle of its own to expand back from. Double down-chevron, matching the collapse-toward-the-bottom direction. -->
                            <Button x:Name="CollapseSessionSubPanelButton" Width="24" Height="20" Margin="0,8,0,0" Padding="0"
                                    Background="Transparent" BorderThickness="0" Click="OnCollapseSessionSubPanelClick" ToolTip="Collapse">
                                <Canvas Width="14" Height="10">
                                    <Polyline Points="1,1 7,4 13,1" Stroke="{DynamicResource Theme.Brush.SecondaryForeground}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Polyline Points="1,6 7,9 13,6" Stroke="{DynamicResource Theme.Brush.SecondaryForeground}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent" />
                                </Canvas>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <!-- Memories: session's Claude memory folder's .md files, MEMORY.md pinned first - see SessionScope.MemoryFileListBuilder. -->
                        <Grid x:Name="MemoriesSectionView" Visibility="Collapsed">
                            <ListBox x:Name="MemoriesList" Background="{DynamicResource Theme.Brush.WindowBackground}" BorderThickness="0"
                                     SelectionChanged="OnMemoriesListSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="4" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="MemoriesEmptyText" Text="No memories for this session" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>

                        <!-- Session-scoped Context/Skills: mirrors ContextPanel's own tree+separator+list structure above, rooted at the repo instead of ~. -->
                        <Grid x:Name="ContextSkillsSectionView" Visibility="Collapsed">
                            <Grid x:Name="SessionContextPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MaxHeight="220" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TreeView x:Name="SessionContextTree" Grid.Row="0" Background="{DynamicResource Theme.Brush.WindowBackground}" BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ItemContainerStyle="{StaticResource ContextTreeItemStyle}"
                                          SelectedItemChanged="OnSessionContextTreeSelectedItemChanged">
                                    <TreeView.Resources>
                                        <!-- Same selection-highlight overrides as Tree/ContextTree above, duplicated since each TreeView's Resources is its own scope. -->
                                        <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightBrushKey}" Color="{DynamicResource Theme.Color.Accent}" />
                                        <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightTextBrushKey}" Color="White" />
                                        <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedBackground}" />
                                        <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlTextBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedForeground}" />
                                        <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedBackground}" />
                                        <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource Theme.Color.SelectionUnfocusedForeground}" />
                                    </TreeView.Resources>
                                </TreeView>

                                <Border Grid.Row="1" Height="1" Margin="4,4" Background="{DynamicResource Theme.Brush.Border}" />

                                <!--
                                    Static "Skills" label - unlike the rail panel's SkillsGroupHeader,
                                    this one never collapses anything (SessionSkillsList always shows
                                    below it), it just exists to host the right-click "Add new" menu
                                    for a project-level skill. Its content is dynamic (gated on
                                    whether the current session's cwd resolves to a repo) so it uses
                                    ContextMenuOpening rather than a static XAML-declared menu - see
                                    OnSessionSkillsGroupHeaderContextMenuOpening.
                                -->
                                <Border Grid.Row="2" Height="24" Background="Transparent"
                                        ContextMenuOpening="OnSessionSkillsGroupHeaderContextMenuOpening">
                                    <Border.ContextMenu>
                                        <ContextMenu x:Name="SessionSkillsGroupHeaderContextMenu" />
                                    </Border.ContextMenu>
                                    <TextBlock Text="Skills" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" />
                                </Border>

                                <ListBox x:Name="SessionSkillsList" Grid.Row="3" Background="{DynamicResource Theme.Brush.WindowBackground}" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnSessionSkillsListSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                        <StackPanel.ToolTip>
                                            <!-- Path on its own line, full description wrapped below it at a fixed
                                                 width - some descriptions run long, so an unconstrained tooltip
                                                 would otherwise stretch across the screen. -->
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Info.FilePath}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel.ToolTip>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" />
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <TextBlock x:Name="SessionContextSkillsEmptyText" Text="Not a git repo" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>

                        <!-- Session-scoped Output Styles: flat list of this repo's .claude/output-styles/*.md - mirrors MemoriesSectionView's single-list shape (no tree). -->
                        <Grid x:Name="OutputStylesSectionView" Visibility="Collapsed">
                            <ListBox x:Name="SessionOutputStylesList" Background="{DynamicResource Theme.Brush.WindowBackground}" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="OnSessionOutputStylesListSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                        <StackPanel.ToolTip>
                                            <!-- Path on its own line, full description wrapped below it at a fixed
                                                 width - some descriptions run long, so an unconstrained tooltip
                                                 would otherwise stretch across the screen. -->
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Info.FilePath}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel.ToolTip>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" />
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="SessionOutputStylesEmptyText" Text="No output styles for this repo" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Collapsed: horizontal icon strip, no content - see SetSessionSubPanelCollapsed. -->
                <StackPanel x:Name="SessionSubPanelCollapsedStrip" Orientation="Horizontal" Background="{DynamicResource Theme.Brush.RailBackground}">
                    <Grid x:Name="SessionMemoriesIconCollapsed" Width="32" Height="32" Margin="4"
                          MouseLeftButtonDown="OnSessionMemoriesIconClick" ToolTip="Memories">
                        <Border Width="24" Height="24" Background="{DynamicResource Theme.Brush.RailTileBackground}" CornerRadius="4">
                            <!-- Same ThoughtBubble glyph as the expanded icon, just smaller. -->
                            <TextBlock Text="&#xEA91;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource Theme.Brush.AccentSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid x:Name="SessionContextSkillsIconCollapsed" Width="32" Height="32" Margin="0,4,4,4"
                          MouseLeftButtonDown="OnSessionContextSkillsIconClick" ToolTip="Context / Skills (this repo)">
                        <Border Width="24" Height="24" Background="{DynamicResource Theme.Brush.RailTileBackground}" CornerRadius="4">
                            <Canvas Width="16" Height="16">
                                <Border Width="11" Height="13" Canvas.Left="2.5" Canvas.Top="1.5" CornerRadius="1.5" Background="{DynamicResource Theme.Brush.AccentSecondary}" />
                                <Rectangle Width="7" Height="1" Canvas.Left="4.5" Canvas.Top="5" Fill="#1E1E1E" />
                                <Rectangle Width="7" Height="1" Canvas.Left="4.5" Canvas.Top="7.5" Fill="#1E1E1E" />
                                <Rectangle Width="4" Height="1" Canvas.Left="4.5" Canvas.Top="10" Fill="#1E1E1E" />
                            </Canvas>
                        </Border>
                    </Grid>

                    <Grid x:Name="SessionOutputStylesIconCollapsed" Width="32" Height="32" Margin="0,4,4,4"
                          MouseLeftButtonDown="OnSessionOutputStylesIconClick" ToolTip="Output Styles (this repo)">
                        <Border Width="24" Height="24" Background="{DynamicResource Theme.Brush.RailTileBackground}" CornerRadius="4">
                            <Canvas Width="16" Height="16">
                                <Ellipse Width="12" Height="9" Canvas.Left="2" Canvas.Top="3.5" Fill="{DynamicResource Theme.Brush.AccentSecondary}" />
                                <Ellipse Width="2.5" Height="2.5" Canvas.Left="4" Canvas.Top="6" Fill="{DynamicResource Theme.Brush.AccentCoral}" />
                                <Ellipse Width="2.5" Height="2.5" Canvas.Left="7.5" Canvas.Top="4.5" Fill="#1E1E1E" />
                                <Ellipse Width="2.5" Height="2.5" Canvas.Left="10" Canvas.Top="6.5" Fill="{DynamicResource Theme.Brush.Accent}" />
                            </Canvas>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource Theme.Brush.WindowBackground}" ResizeBehavior="PreviousAndNext" />

        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Tab strip: one tab per session opened from the Tree (see MainWindow.OpenTab),
                independent of which tree node happens to be selected - selecting a Project node no
                longer disturbs whichever tab is active (see MainWindow.OnTreeSelectedItemChanged).
                Collapsed entirely while the Skills rail section is active - see SetRailSection.
            -->
            <Border x:Name="TabStripHost" Grid.Row="0" Background="#181818" BorderBrush="#2D2D30" BorderThickness="0,0,0,1">
                <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource SessionTabItemTemplate}"
                         ItemContainerStyle="{StaticResource SessionTabItemContainerStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="OnTabStripSelectionChanged"
                         AllowDrop="True"
                         DragOver="OnTabStripDragOver"
                         Drop="OnTabStripDrop">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <Grid Grid.Row="1">
                <!--
                    Shown whenever there's no active tab (nothing ever opened, or the active tab
                    was just closed) and no skill is selected either. Always present, never
                    removed - only Visibility toggles, same rule as the session panes and
                    MarkdownEditor below.
                -->
                <TextBlock x:Name="PlaceholderText" Text="Select or launch a session" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Shown instead of launching when the active tab's session fails validation. -->
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Theme.Brush.Error}" TextWrapping="Wrap" MaxWidth="500"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                <!--
                    Every running session's Pane.View is added here exactly once, permanently, for
                    that host's entire lifetime. Tab switching only ever toggles Visibility - never
                    swap Content/Children membership for a live view. See the comment in
                    MainWindow.LaunchSession for why.
                -->
                <Grid x:Name="SessionViewHost" />

                <!-- Rendered/edited markdown for the currently selected Context node - see MarkdownEditor\MarkdownEditorView. -->
                <mde:MarkdownEditorView x:Name="MarkdownEditor" Visibility="Collapsed" />

                <!-- Structured editor for the currently selected (or newly-created) skill - see Skills\SkillEditor\SkillEditorView. -->
                <se:SkillEditorView x:Name="SkillEditor" Visibility="Collapsed" />

                <!-- App preferences - see Settings\SettingsView. -->
                <settings:SettingsView x:Name="SettingsView" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
