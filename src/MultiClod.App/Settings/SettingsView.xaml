<UserControl x:Class="MultiClod.App.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared with MarkdownEditor\MarkdownEditorView's Edit toggle - not duplicated here. -->
                <ResourceDictionary Source="/MultiClod.App;component/MarkdownEditor/ToggleSwitchStyle.xaml" />
                <!-- TextBox/Button/ComboBox/RadioButton styles - shared with Skills\SkillEditor\SkillEditorView. -->
                <ResourceDictionary Source="/MultiClod.App;component/Styles/FormControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Theme.Brush.WindowBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

            <TextBlock Text="Appearance" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />

            <TextBlock Text="Theme" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" Margin="0,0,0,6" />
            <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Content="Dark" Checked="OnThemeRadioChecked" />
            <RadioButton x:Name="DarkLowContrastThemeRadio" GroupName="Theme" Content="Dark (Low Contrast)" Checked="OnThemeRadioChecked" />
            <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Content="Light" Checked="OnThemeRadioChecked" Margin="0,0,0,16" />

            <TextBlock Text="General" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ToggleButton x:Name="ShiftEnterToggle" Style="{StaticResource ToggleSwitchStyle}"
                              Click="OnShiftEnterToggleClick" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Use Shift+Enter for newlines" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="When on, Shift+Enter inserts a newline in a session instead of Ctrl+Enter."
                       Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextWrapping="Wrap" Margin="52,0,0,0" />

            <TextBlock Text="Sessions" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="12" FontWeight="Bold" Margin="0,20,0,8" />

            <TextBlock Text="Default root folder" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DefaultRootFolderBox" Grid.Column="0" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse..." Click="OnBrowseDefaultRootFolderClick" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="New sessions default to this folder (see Add Session's form)."
                       Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ToggleButton x:Name="WorktreeToggle" Style="{StaticResource ToggleSwitchStyle}"
                              Click="OnWorktreeToggleClick" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Start new sessions with a git worktree" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Pre-checks &quot;Create a git worktree&quot; in the Add Session form - still editable per session."
                       Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextWrapping="Wrap" Margin="52,0,0,0" />

            <TextBlock Text="Default permission mode" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" Margin="0,16,0,4" />
            <ComboBox x:Name="PermissionModeCombo" HorizontalAlignment="Left" MinWidth="260"
                      SelectionChanged="OnPermissionModeSelectionChanged">
                <ComboBoxItem Tag="Manual" Content="Manual (ask before every action)" />
                <ComboBoxItem Tag="Auto" Content="Auto (classifier decides what needs approval)" />
                <ComboBoxItem Tag="AcceptEdits" Content="Accept edits automatically" />
                <ComboBoxItem Tag="Plan" Content="Plan mode (research only, no changes)" />
                <ComboBoxItem Tag="BypassPermissions" Content="Bypass permissions (no prompts at all)" />
            </ComboBox>
            <TextBlock Text="Which mode a brand-new session's claude process starts in (same modes Shift+Tab cycles through inside a session). Only applies to sessions launched after this is changed."
                       Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ToggleButton x:Name="ShowCostsToggle" Style="{StaticResource ToggleSwitchStyle}"
                              Click="OnShowCostsToggleClick" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Show estimated costs" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Shows estimated Claude API cost next to session names, in the Session Log window, and per transcript entry."
                       Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextWrapping="Wrap" Margin="52,0,0,16" />

            <TextBlock Text="Terminal" Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="12" FontWeight="Bold" Margin="0,4,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ToggleButton x:Name="DisableMouseCopyToggle" Style="{StaticResource ToggleSwitchStyle}"
                              Click="OnDisableMouseCopyToggleClick" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Disable Mouse Copy" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="When on, dragging or double-clicking in a session only highlights text - Claude Code's own mouse-driven auto-copy is disabled, so Ctrl+C is the only thing that touches the clipboard. Turning this off also restores any other mouse interaction inside the CLI. Only applies to sessions launched after this is changed."
                       Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextWrapping="Wrap" Margin="52,0,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ToggleButton x:Name="RemapCtrlZForUndoToggle" Style="{StaticResource ToggleSwitchStyle}"
                              Click="OnRemapCtrlZForUndoToggleClick" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Ctrl+Z triggers undo" Foreground="{DynamicResource Theme.Brush.PrimaryForeground}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Claude Code's CLI reserves Ctrl+Z for Unix process-suspend and binds its own undo to Ctrl+_/Ctrl+Shift+- instead, so plain Ctrl+Z does nothing there. When on, Ctrl+Z sends Ctrl+_'s byte instead, so undo works without needing to learn a different shortcut. Applies to already-running sessions immediately."
                       Foreground="{DynamicResource Theme.Brush.SecondaryForeground}" FontSize="11" TextWrapping="Wrap" Margin="52,0,0,0" />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
